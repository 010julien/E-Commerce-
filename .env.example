# Cool-Chic E-commerce Environment Variables

# Application
REACT_APP_NAME=Cool-Chic
REACT_APP_VERSION=1.0.0
REACT_APP_DESCRIPTION=Plateforme e-commerce moderne

# API Configuration
REACT_APP_API_URL=https://api.cool-chic.fr
REACT_APP_API_VERSION=v1

# Payment Configuration
REACT_APP_STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
REACT_APP_PAYPAL_CLIENT_ID=your_paypal_client_id

# External Services
REACT_APP_GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX
REACT_APP_FACEBOOK_PIXEL_ID=your_facebook_pixel_id

# Feature Flags
REACT_APP_ENABLE_PRIME_VIDEO=true
REACT_APP_ENABLE_KINDLE=true
REACT_APP_ENABLE_MUSIC=true
REACT_APP_ENABLE_GAMING=true

# Development
REACT_APP_DEBUG=true
REACT_APP_LOG_LEVEL=debug

# Social Login
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id
REACT_APP_FACEBOOK_APP_ID=your_facebook_app_id

# Storage
REACT_APP_AWS_S3_BUCKET=cool-chic-assets
REACT_APP_CDN_URL=https://cdn.cool-chic.fr

# Notifications
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key
REACT_APP_FIREBASE_PROJECT_ID=cool-chic-notifications
